{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ailobang",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ailobang-users",
      "database_id": "6c540dce-93de-460c-852d-e1b306255fcd"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VOICE_AGENT",
        "class_name": "VoiceAgent"
      },
      {
        "name": "TELEGRAM_SESSION",
        "class_name": "TelegramSession"
      },
      {
        "name": "CODING_AGENT",
        "class_name": "CodingAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoiceAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TelegramSession"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["CodingAgent"]
    }
  ],
  "vars": {
    "WORKOS_CLIENT_ID": "client_01M2VVVWWF3AT72D5H8FRM0P2Y",
    "WORKOS_REDIRECT_URI": "https://ailobang.com/callback",
    // The US Telnyx number: it phones out the link codes and takes the calls.
    "TELNYX_PHONE_NUMBER": "+14073580773",
    // The Telnyx account and the TeXML app ("ailobang-phone-codes") that place code calls.
    "TELNYX_ACCOUNT_SID": "925b1346-e092-4517-b93b-b861b01c0dbf",
    "TELNYX_TEXML_APP_ID": "3057630664552613184",
    // Which Plaid environment the PLAID_CLIENT_ID / PLAID_SECRET secrets belong to:
    // "sandbox" (test banks only) or "production" (real banks).
    "PLAID_ENV": "sandbox"
  },
  "routes": [
    {
      "pattern": "ailobang.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
