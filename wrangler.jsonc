{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ailobang",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ailobang-users",
      "database_id": "6c540dce-93de-460c-852d-e1b306255fcd"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VOICE_AGENT",
        "class_name": "VoiceAgent"
      },
      {
        "name": "TELEGRAM_SESSION",
        "class_name": "TelegramSession"
      },
      {
        "name": "CODING_AGENT",
        "class_name": "CodingAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoiceAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TelegramSession"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["CodingAgent"]
    }
  ],
  "vars": {
    "WORKOS_CLIENT_ID": "client_01M2VVVWWF3AT72D5H8FRM0P2Y",
    "WORKOS_REDIRECT_URI": "https://ailobang.com/callback"
  },
  "routes": [
    {
      "pattern": "ailobang.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
